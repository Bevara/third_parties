diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2105671..7d48782 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -90,7 +90,13 @@ endif()
 
 string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" SYSTEM_PROCESSOR)
 message("SYSTEM_PROCESSOR=${CMAKE_SYSTEM_PROCESSOR}")
-if(ARM OR SYSTEM_PROCESSOR MATCHES "^(arm|aarch)")
+if(EMSCRIPTEN)
+  # emscripten reports CMAKE_SYSTEM_PROCESSOR as "x86", which would select the
+  # sse/ and avx/ sources; those include <x86intrin.h> and the whole SSE3/AVX
+  # header set, none of which wasm has. Leaving both ARM and X86 undefined
+  # takes xevd_port.h and xevd_def.h down their portable C path.
+  set(ARM "FALSE")
+elseif(ARM OR SYSTEM_PROCESSOR MATCHES "^(arm|aarch)")
   set(ARM "TRUE")
   add_definitions(-DARM=1)
 elseif(SYSTEM_PROCESSOR MATCHES "^(x86|amd64|ia64|i386|i686)")
@@ -122,7 +128,13 @@ elseif("${CMAKE_C_COMPILER_ID}" STREQUAL "Clang")
         set(OPT_DBG "-DNDEBUG") # disable assert
     endif()
 
+    if(EMSCRIPTEN)
+      # -pthread makes emscripten emit atomics and shared memory, which a side
+      # module cannot link against. xevd runs single-threaded with threads = 1.
+      set (CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${OPT_DBG} -${OPT_LV} -fomit-frame-pointer -std=c99")
+    else()
     set (CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${OPT_DBG} -${OPT_LV} -fomit-frame-pointer -pthread -std=c99")
+    endif()
     set (CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wno-pointer-sign -Wno-unused-function -Wno-unused-variable")
     set (CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -lm")
 elseif( UNIX OR MINGW )

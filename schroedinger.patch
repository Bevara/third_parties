diff --git a/schroedinger/schrodomain.c b/schroedinger/schrodomain.c
index 018cd26..6f73339 100644
--- a/schroedinger/schrodomain.c
+++ b/schroedinger/schrodomain.c
@@ -12,6 +12,25 @@
 
 /* SchroMemoryDomain */
 
+/* free is void(void*), but SchroMemoryDomain::free is declared
+ * void(void*, int) and is called with two arguments. Casting through
+ * (void*) hid that: a native call simply ignores the extra argument,
+ * while WebAssembly checks the signature at every indirect call and
+ * traps with "function signature mismatch". These two wrappers give the
+ * pointers the arity the struct declares. */
+static void *
+schro_domain_alloc (int size)
+{
+  return malloc (size);
+}
+
+static void
+schro_domain_free (void *ptr, int size)
+{
+  (void) size;
+  free (ptr);
+}
+
 SchroMemoryDomain *
 schro_memory_domain_new (void)
 {
@@ -31,8 +50,8 @@ schro_memory_domain_new_local (void)
 
   domain = schro_memory_domain_new ();
 
-  domain->alloc = (void *) malloc;
-  domain->free = (void *) free;
+  domain->alloc = schro_domain_alloc;
+  domain->free = schro_domain_free;
   domain->flags = SCHRO_MEMORY_DOMAIN_CPU;
 
   return domain;

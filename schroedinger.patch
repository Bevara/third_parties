diff --git a/orc/orc.h b/orc/orc.h
new file mode 100644
index 0000000..4b3b3b3
--- /dev/null
+++ b/orc/orc.h
@@ -0,0 +1,36 @@
+/*
+ *  Minimal stand-in for <orc/orc.h>.
+ *
+ *  schroedinger is built with -DDISABLE_ORC, so every orc program in
+ *  schroorc-dist.c takes its plain-C branch and the orc runtime is never
+ *  entered. What is still needed from this header is four names: two integer
+ *  typedefs, and the two memory helpers orc exposes as thin wrappers.
+ */
+#ifndef SCHRO_ORC_SHIM_H
+#define SCHRO_ORC_SHIM_H
+
+#include <stdint.h>
+#include <string.h>
+
+typedef int16_t orc_int16;
+typedef int32_t orc_int32;
+typedef int64_t orc_int64;
+typedef uint8_t orc_uint8;
+typedef uint16_t orc_uint16;
+typedef uint32_t orc_uint32;
+typedef uint64_t orc_uint64;
+
+
+/* Opaque: schromotion.h keeps OrcProgram* fields in a struct unconditionally,
+ * but with DISABLE_ORC nothing ever dereferences them. */
+typedef struct _OrcProgram OrcProgram;
+typedef struct _OrcExecutor OrcExecutor;
+
+/* schro.c calls orc_init() from schro_init(); with DISABLE_ORC there is
+ * nothing to initialise. */
+static inline void orc_init(void) { }
+
+static inline void orc_memcpy(void *dst, const void *src, int n) { memcpy(dst, src, (size_t)n); }
+static inline void orc_memset(void *dst, int c, int n) { memset(dst, c, (size_t)n); }
+
+#endif
diff --git a/schroedinger/schro_noorc.c b/schroedinger/schro_noorc.c
new file mode 100644
index 0000000..238ebc8
--- /dev/null
+++ b/schroedinger/schro_noorc.c
@@ -0,0 +1,37 @@
+/*
+ *  The two renderers schroedinger generates machine code for at run time.
+ *
+ *  schromotion8.c builds its block accumulators with orc_program_compile(),
+ *  which is a JIT: it emits native instructions into a buffer and jumps to
+ *  them. WebAssembly cannot do that, so that file is not built. schroedinger
+ *  ships a complete C reference renderer for exactly this case
+ *  (schromotionref.c, selected by _schro_motion_ref), and the patch turns it
+ *  on unconditionally - so the two entry points below are never reached.
+ *  They abort rather than return silently: a motion-compensated frame that
+ *  quietly came back blank would be far harder to notice.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <schroedinger/schro.h>
+
+void schro_motion_render_u8 (SchroMotion *motion, SchroFrame *dest,
+    SchroFrame *addframe, int add, SchroFrame *output_frame)
+{
+  (void)motion; (void)dest; (void)addframe; (void)add; (void)output_frame;
+  fprintf (stderr, "[schro] the orc motion renderer is not built; "
+                   "_schro_motion_ref should have routed this to the reference one\n");
+  abort ();
+}
+
+void schro_motion_render_fast (SchroMotion *motion, SchroFrame *dest,
+    SchroFrame *addframe, int add, SchroFrame *output_frame)
+{
+  (void)motion; (void)dest; (void)addframe; (void)add; (void)output_frame;
+  abort ();
+}
+
+int schro_motion_render_fast_allowed (SchroMotion *motion)
+{
+  (void)motion;
+  return 0;
+}
diff --git a/schroedinger/schrobufferlist.c b/schroedinger/schrobufferlist.c
index 44d23df..8a0595f 100644
--- a/schroedinger/schrobufferlist.c
+++ b/schroedinger/schrobufferlist.c
@@ -21,12 +21,25 @@
  *
  * Returns: a new (empty) buffer list.
  */
+/* WebAssembly checks the signature at every indirect call, so a function
+ * pointer cast to a type with a different number of parameters traps at
+ * run time ("function signature mismatch") where a native call simply
+ * ignores the surplus argument. schroedinger casts its one-argument unref
+ * functions to the two-argument free typedefs its containers declare;
+ * these adapters give them the arity the typedef promises. */
+static void
+schro_buflist_free_buffer (void *member, void *priv)
+{
+  (void) priv;
+  schro_buffer_unref ((SchroBuffer *) member);
+}
+
 SchroBufferList *
 schro_buflist_new (void)
 {
   SchroBufferList *buflist = schro_malloc0 (sizeof (*buflist));
   buflist->list =
-      schro_list_new_full ((SchroListFreeFunc) schro_buffer_unref, NULL);
+      schro_list_new_full (schro_buflist_free_buffer, NULL);
   buflist->offset = 0;
 
   return buflist;

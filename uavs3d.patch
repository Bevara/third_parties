diff --git a/source/CMakeLists.txt b/source/CMakeLists.txt
index 316bdc4..72fdcc1 100644
--- a/source/CMakeLists.txt
+++ b/source/CMakeLists.txt
@@ -1,7 +1,13 @@
 set(LIBNAME uavs3d)
 
 # check cpu
-if("${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "AMD64" OR
+# Emscripten reports CMAKE_SYSTEM_PROCESSOR as "x86", which would select the
+# SSE and AVX2 sources below. Those do not build for wasm: emscripten emulates
+# SSE but not MMX, and decore/sse uses __m64. wasm32 therefore takes the
+# generic C path.
+if(EMSCRIPTEN)
+  set(UAVS3D_TARGET_CPU "generic")
+elseif("${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "AMD64" OR
    "${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "x86_64")
   if(${CMAKE_SIZEOF_VOID_P} EQUAL 4)
     set(UAVS3D_TARGET_CPU "x86")

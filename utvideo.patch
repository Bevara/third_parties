@@ -161,7 +161,63 @@ void CThreadManager::WaitForJobCompletion(void)
 
 #endif
 
-#if defined(__APPLE__) || defined(__unix__)
+/* ---------------------------------------------------------------------------
+ * UTVIDEO_SINGLE_THREAD: a job submitted here only ever runs on a pool
+ * thread, so on a target without threads - a WebAssembly side module, for
+ * instance - pthread_create starts nothing, the queue is never drained and
+ * WaitForJobCompletion blocks forever. With this set the manager keeps no
+ * threads and runs each job where it is submitted. Bands are independent and
+ * WaitForJobCompletion is the only synchronisation point, so running them in
+ * submission order gives the same result. */
+#ifndef UTVIDEO_SINGLE_THREAD
+#if defined(__EMSCRIPTEN__)
+#define UTVIDEO_SINGLE_THREAD 1
+#else
+#define UTVIDEO_SINGLE_THREAD 0
+#endif
+#endif
+
+#if UTVIDEO_SINGLE_THREAD
+
+int CThreadManager::GetNumProcessors(void)
+{
+	return 1;
+}
+
+CThreadManager::CThreadManager(void)
+{
+	m_nNumJobs = 0;
+	m_nNumCompleteJobs = 0;
+	m_nNumThreads = 0;
+	for (int i = 0; i < MAX_THREAD; i++)
+		m_ptidThread[i] = 0;
+}
+
+CThreadManager::~CThreadManager(void)
+{
+}
+
+void *CThreadManager::StaticThreadProc(void *arg)
+{
+	return NULL;
+}
+
+void *CThreadManager::ThreadProc(int nThreadIndex)
+{
+	return NULL;
+}
+
+void CThreadManager::SubmitJob(CThreadJob *pJob, uint32_t dwAffinityHint)
+{
+	pJob->JobProc(this);
+	delete pJob;
+}
+
+void CThreadManager::WaitForJobCompletion(void)
+{
+}
+
+#elif defined(__APPLE__) || defined(__unix__)
 
